"function _editorialCallouts(payload) {",
"  const section = (label, value) => {",
"    const paragraphs = (Array.isArray(value) ? value : [value])",
"      .filter(item => typeof item === \"string\" && item.trim());",
"    if (!paragraphs.length) return \"\";",
"    return `<section class=\"editorial-callout\"><h2>${label}</h2>${paragraphs.map(item => `<p>${_escHtml(item)}</p>`).join(\"\")}</section>`;",
"  };",
"  return section(\"Why it matters\", payload?.whyItMatters || payload?.why_it_matters)",
"    + section(\"What to watch\", payload?.whatToWatch || payload?.what_to_watch);",
"}",
""
]
},
