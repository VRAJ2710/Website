+function fe88_parseUtc(s) {
+  if (s == null || s === "") return null;
+  var t = String(s).trim();
+  if (/^\d{4}-\d{2}-\d{2} \d{2}:\d{2}/.test(t)) t = t.replace(" ", "T").replace(/ UTC$/i, "Z");
+  else if (/ UTC$/i.test(t)) t = t.replace(/ UTC$/i, "Z");
+  var d = new Date(t);
+  if (isNaN(d.getTime())) return null;
+  return d;
+}
+function fe88_uk(s) {
+  var d = fe88_parseUtc(s);
