+  return "<tr>" +
+    '<td data-label="Rank">' + fe88_esc(row.rank == null ? "" : String(row.rank)) + "</td>" +
+    '<th scope="row" data-label="Instrument"><a href="' + href + '">' + fe88_esc(row.ticker || "") + "</a>" + company + group + "</th>" +
