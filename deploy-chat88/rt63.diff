+    .replace(/>/g, "&gt;")
+    .replace(/"/g, "&quot;");
+}
+function fe88_known(tk) {
+  var i;
+  for (i = 0; i < FE88_LIST.length; i++) if (FE88_LIST[i] === tk) return true;
+  return false;
+}
+function fe88_tickerOk(tk) {
+  return /^[A-Z0-9.-]{1,10}$/.test(String(tk || ""));
+}
+function fe88_parse(pathname) {
+  var p = String(pathname || "");
+  var cut = p.indexOf("?");
+  if (cut >= 0) p = p.slice(0, cut);
+  cut = p.indexOf("#");
+  if (cut >= 0) p = p.slice(0, cut);
+  if (p.length > 1 && p.charAt(p.length - 1) === "/") p = p.slice(0, -1);
+  if (p !== FE88_BASE && p.indexOf(FE88_BASE + "/") !== 0) return null;
+  var rest = p.slice(FE88_BASE.length);
+  if (!rest) return { kind: "radar", more: false };
+  var seg = rest.charAt(0) === "/" ? rest.slice(1) : rest;
+  try { seg = decodeURIComponent(seg); } catch (eDec) {}
+  if (!seg || seg.indexOf("/") >= 0) return { kind: "bad", raw: seg };
+  if (seg.toLowerCase() === "method") return { kind: "method" };
+  var tk = seg.toUpperCase();
+  if (!fe88_tickerOk(tk)) return { kind: "bad", raw: seg };
