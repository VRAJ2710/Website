 var pg = "home";
 function IS_DESKTOP(){ return (typeof window !== "undefined" && window.innerWidth >= 768); }
 // ── rt62i ──
+
+// ── rt63 ──
+// fe88: Capital Sustainability Monitor. Three client routes, one research card.
