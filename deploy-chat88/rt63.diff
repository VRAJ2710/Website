+  }
+  var turns = "";
+  if (flag && Array.isArray(flag.turned_worse) && flag.turned_worse.length) {
+    turns += " Turned worse: " + flag.turned_worse.map(fe88_flagName).join(", ") + ".";
+  }
+  if (flag && Array.isArray(flag.turned_better) && flag.turned_better.length) {
