+}
+function fe88_marketOk(market) {
+  return !!(market && market.status === "ok");
+}
+function fe88_scoreBits(row) {
+  if (!row) return { text: "", note: "" };
+  if (!fe88_marketOk(row.market)) {
+    var filing = row.filing_only_score;
+    if (filing == null && row.filing_score && typeof row.filing_score === "object") filing = row.filing_score.score;
+    if (filing == null && typeof row.filing_score === "number") filing = row.filing_score;
+    return { text: fe88_num(filing), note: "Filing score" };
+  }
+  var radar = row.radar_score;
+  if (radar == null && row.market_score && typeof row.market_score === "object") radar = null;
+  return { text: fe88_num(radar), note: "Radar score" };
+}
+function fe88_spark(values) {
+  if (!Array.isArray(values)) return "";
+  var nums = [];
+  var i, n, min, max, span, w, h, d, x, y, k;
+  for (i = 0; i < values.length; i++) {
+    n = values[i];
+    if (typeof n === "string" && n && isFinite(Number(n))) n = Number(n);
+    if (typeof n === "number" && isFinite(n)) nums.push(n);
+  }
+  if (nums.length < 2) return "";
+  min = nums[0];
+  max = nums[0];
+  for (i = 1; i < nums.length; i++) {
+    if (nums[i] < min) min = nums[i];
+    if (nums[i] > max) max = nums[i];
+  }
+  w = 88;
+  h = 28;
+  span = (max - min) || 1;
+  d = [];
+  for (k = 0; k < nums.length; k++) {
+    x = (k / (nums.length - 1)) * (w - 2) + 1;
+    y = (h - 2) - ((nums[k] - min) / span) * (h - 4);
+    d.push((k ? "L" : "M") + x.toFixed(1) + " " + y.toFixed(1));
+  }
+  return '<svg class="fe88-spark" viewBox="0 0 ' + w + ' ' + h + '" width="' + w + '" height="' + h + '" role="img" aria-label="' + fe88_esc("Daily closes, " + nums.length + " sessions, delayed") + '" focusable="false"><path d="' + d.join(" ") + '" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" stroke-linecap="round"></path></svg>';
+}
+function fe88_miss(label) {
