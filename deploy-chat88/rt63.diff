+var FE88_FLAG_ORDER = ["sustainability_gap", "fcf_coverage", "debt_reliance", "interest_burden", "margin_trend"];
+var fe88_NUM = new Intl.NumberFormat("en-GB", { maximumFractionDigits: 2 });
+var fe88_PX = new Intl.NumberFormat("en-GB", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
+var fe88_INT = new Intl.NumberFormat("en-GB", { maximumFractionDigits: 0 });
+var fe88_PCT;
+try {
+  fe88_PCT = new Intl.NumberFormat("en-GB", { minimumFractionDigits: 2, maximumFractionDigits: 2, signDisplay: "exceptZero" });
+} catch (ePct) {
+  fe88_PCT = new Intl.NumberFormat("en-GB", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
+}
+var fe88_UK = new Intl.DateTimeFormat("en-GB", {
+  timeZone: "Europe/London",
+  weekday: "short",
+  day: "numeric",
+  month: "short",
+  hour: "2-digit",
+  minute: "2-digit",
+  hourCycle: "h23"
+});
+
+function fe88_esc(s) {
+  return String(s == null ? "" : s)
+    .replace(/&/g, "&amp;")
