+}
+function fe88_generic(value, depth, cik) {
+  if (value == null) return "";
+  if (depth > 3) return "";
+  if (typeof value === "number") return fe88_esc(fe88_num(value));
+  if (typeof value === "string") {
+    if (!value || value === "null" || value === "undefined" || value === "NaN") return "";
+    return fe88_esc(value);
+  }
+  if (typeof value === "boolean") return value ? "Yes" : "No";
+  if (Array.isArray(value)) {
+    var i, parts = [], child, href, name;
+    if (!value.length) return "";
+    for (i = 0; i < value.length && i < 12; i++) {
+      child = value[i];
+      if (child == null) continue;
+      if (typeof child === "string" || typeof child === "number") {
+        var bit = fe88_generic(child, depth + 1, cik);
+        if (bit) parts.push("<li>" + bit + "</li>");
+        continue;
+      }
+      if (fe88_isLinkRow(child)) {
+        href = fe88_secHref(child, cik);
+        name = child.label || child.title || child.form || child.accession || "SEC filing";
+        var meta = [];
