+    var keys = Object.keys(value);
+    var rows = [];
+    var k, cell;
+    for (k = 0; k < keys.length && k < 40; k++) {
+      if (keys[k] === "label" && keys.length > 1) continue;
+      cell = fe88_generic(value[keys[k]], depth + 1, value.cik || cik);
