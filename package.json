{
  "name": "dispatch-markets",
  "version": "1.0.0",
  "description": "The Dispatch Markets — AI-assisted market intelligence terminal",
  "main": "index.js",
  "scripts": {
    "test": "npm run story:check && npm run test:market-proxy && npm run test:billing && npm run test:auth",
    "test:market-proxy": "node --test test/market-proxy.test.js",
    "test:billing": "node --test test/billing-origin.test.js",
    "test:auth": "node --test --test-force-exit test/auth.integration.test.js",
    "story:check": "tsc -p tsconfig.story.json",
    "story:generate": "drizzle-kit generate --config drizzle.config.ts",
    "story:migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "story:dev": "wrangler dev --config wrangler.story.toml --test-scheduled",
    "story:deploy": "wrangler deploy --config wrangler.story.toml"
  },
