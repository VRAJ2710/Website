    "drizzle-orm": "^0.45.2",
    "fast-xml-parser": "^5.10.1",
    "openai": "^6.49.0",
    "stripe": "^22.5.0",
    "stripe-replit-sync": "^1.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260724.1",
    "@types/node": "^26.1.1",
